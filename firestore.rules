rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function revision(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,100}$');
    }
    function count(value) {
      return value is int && value >= 0 && value <= 5000;
    }
    function entry(data) {
      return data is map
        && data.keys().hasAll(['revision', 'parts', 'at', 'rides', 'wishlist'])
        && data.keys().hasOnly(['revision', 'parts', 'at', 'rides', 'wishlist', 'parks'])
        && revision(data.revision)
        && data.parts is int && data.parts >= 1 && data.parts <= 60
        && data.at is string && data.at.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$')
        && count(data.rides) && count(data.wishlist)
        && (!('parks' in data) || count(data.parks));
    }
    function historyItem(items, index) {
      // Current snapshot is fully checked separately. Older entries only drive the recovery UI;
      // keep these checks small enough for a full history within the rule evaluation budget.
      return items.size() <= index || (items[index] is map
        && items[index].keys().hasOnly(['revision', 'parts', 'at', 'rides', 'wishlist', 'parks'])
        && count(items[index].rides) && count(items[index].wishlist));
    }
    function history(items) {
      return items is list && items.size() >= 1 && items.size() <= 10
        && historyItem(items, 0) && historyItem(items, 1)
        && historyItem(items, 2) && historyItem(items, 3)
        && historyItem(items, 4) && historyItem(items, 5)
        && historyItem(items, 6) && historyItem(items, 7)
        && historyItem(items, 8) && historyItem(items, 9);
    }
    function head(data, uid) {
      let saved = getAfter(/databases/$(database)/documents/users/$(uid)/snapshots/$(data.revision)).data;
      return data.keys().hasAll(['revision', 'parts', 'at', 'rides', 'wishlist', 'history'])
        && data.keys().hasOnly(['revision', 'parts', 'at', 'rides', 'wishlist', 'parks', 'history'])
        && history(data.history) && entry(saved)
        && saved == data.history[0]
        && saved.revision == data.revision && saved.parts == data.parts
        && saved.at == data.at && saved.rides == data.rides && saved.wishlist == data.wishlist
        && (!('parks' in data) || saved.parks == data.parks);
    }
    function active(uid, rev) {
      return getAfter(/databases/$(database)/documents/users/$(uid)/collections/main).data.revision == rev;
    }
    function inactive(uid, rev) {
      return get(/databases/$(database)/documents/users/$(uid)/collections/main).data.revision != rev;
    }
    match /users/{uid}/collections/main {
      allow get: if owner(uid);
      allow create, update: if owner(uid) && revision(request.resource.data.revision) && head(request.resource.data, uid);
    }
    match /users/{uid}/snapshots/{rev} {
      allow get: if owner(uid);
      allow create: if owner(uid) && entry(request.resource.data)
        && request.resource.data.revision == rev && active(uid, rev);
      allow delete: if owner(uid) && inactive(uid, rev);
      match /chunks/{index} {
        allow get: if owner(uid);
        allow create: if owner(uid)
          && index.matches('^([0-9]|[1-5][0-9])$')
          && request.resource.data.keys().hasOnly(['text'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 120000
          && int(index) < getAfter(/databases/$(database)/documents/users/$(uid)/snapshots/$(rev)).data.parts
          && active(uid, rev);
        allow delete: if owner(uid) && inactive(uid, rev);
      }
    }
    // Other paths, list queries, metadata updates and active revision deletes are denied.
  }
}
